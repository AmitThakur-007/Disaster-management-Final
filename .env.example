# Copy to .env. Used by `npm run dev` and read by Docker Compose.
# Leave DATABASE_URL unset to use the in-memory demo store.
DATABASE_URL=postgresql://disaster:1234@localhost:15432/disaster_watch
POSTGRES_PASSWORD=1234
DB_PORT=15432
PORT=3001
APP_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
COOKIE_SECURE=false
UPLOAD_DIR=./data/uploads
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
# Optional: set to a vision-capable model (e.g. llava:7b) for AI photo relevance check.
# If not set, photo check falls back to text-only context assessment (no actual image analysis).
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_MS=90000
ADMIN_EMAIL=admin@disasterwatch.np
ADMIN_PASSWORD=Administrator123!
